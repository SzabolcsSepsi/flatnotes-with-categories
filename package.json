    "@toast-ui/editor-plugin-code-syntax-highlight": "3.1.0",
    "axios": "1.21.0",
    "mousetrap": "1.6.5",
    "pinia": "4.0.2",
    "primevue": "3.53.1",
    "vue": "3.5.44",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
